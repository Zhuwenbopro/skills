{
  "host": "hcu-node",
  "container": "sglang-container",
  "workdir": "/home",
  "deployment_dir": "/workspace/sglang-deploy/runs/model-example",
  "model_path": "/models/Qwen3.8-27B",
  "served_model_name": "Qwen3.8-27B",
  "devices": [
    2,
    5
  ],
  "python": "/workspace/sglang-deploy/venv/bin/python",
  "pythonpath": [
    "/workspace/sglang-deploy/src/adapter-das",
    "/workspace/sglang-deploy/src/sglang/python",
    "/workspace/sglang-deploy/src/sglang-plugin-das"
  ],
  "bind_host": "0.0.0.0",
  "port": 30522,
  "env": {
    "HCU_ADAPTER_HOST": "sglang",
    "SGLANG_PLUGINS": "hcu"

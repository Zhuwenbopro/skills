# 调度配置。模型、TP、PP 从 server_command.sh 自动解析。

HOST="127.0.0.1"
HEALTH_HOST="127.0.0.1"                # HOST=0.0.0.0 时仍用它访问服务

SERVER_COMMAND="server_command.sh"
EVAL_COMMAND="eval_command.sh"
RESULT_ROOT="/home/eval_results"

# EvalScope 默认参数；可由 eval Skill 按本轮请求覆盖。
EVAL_ENABLE_THINKING="false"
EVAL_DATASETS="humaneval"
EVAL_BATCH=64
EVAL_LIMIT="None"

# 端口和服务健康检查
START_PORT=30000
END_PORT=35000
# 多个 auto_eval 实例通过端口锁避免同时选中同一端口。
PORT_LOCK_DIR="/tmp/auto_eval_port_locks"
SERVER_START_TIMEOUT=600
# 启动阶段的 /health 探测间隔；服务一旦健康就立即进入 EvalScope。
HEALTH_CHECK_INTERVAL=2

# GPU 空闲标准：显存占用低于 5%，HCU 利用率不高于 0%。
GPU_VRAM_MAX_PERCENT=6
GPU_HCU_MAX_PERCENT=0
GPU_POLL_INTERVAL=30
GPU_CONFIRM_SECONDS=3

# 可选：只从指定卡中选择，例如 "2,3,4,5"；留空表示所有卡。
GPU_ALLOWLIST=""

# 0 表示等卡无限尝试；设为正整数可限制等卡失败次数。
MAX_ATTEMPTS=0

# 停止服务/评测时，先发 TERM，超时后再发 KILL。
SHUTDOWN_TIMEOUT=15
FAILURE_LOG_LINES=100

# 同一台机器上的多个 auto_eval.sh 会通过这些锁避免互相选择同一张卡。
GPU_LOCK_DIR="/tmp/auto_eval_gpu_locks"
